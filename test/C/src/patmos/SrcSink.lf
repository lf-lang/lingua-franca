/**
 * A simple Lingua Franca program for the Patmos target that demonstrates inter-reactor
 * communication with delays.
 */
target C {
  platform: "Patmos",
  single-threaded: true,
  timeout: 3 msec
}

preamble {=
  #define EXPECTED 3
=}

reactor Source {
  output out: int
  timer t(0, 1 msec)
  state s: int = 1
  reaction(startup) {=
    lf_print("Source starting up, initial value: %d", self->s);
  =}
  reaction(t) -> out {=
    lf_set(out, self->s);
    ++self->s;
  =}
}

reactor Sink {
  input in: int
  state last_received: int = 0
  
  reaction(in) {=
    self->last_received = in->value;
    lf_print("Received %d at %lld", in->value, lf_time_logical_elapsed());
  =}

  reaction(shutdown) {=
    if(self->last_received == EXPECTED) {
      lf_print("Last received value was equal to EXPECTED, shutting down.");
    } else {
      lf_print("Last received value was %d, but expected %d. Exiting.", self->last_received, EXPECTED);
      exit(1);
    }
  =}
}

main reactor {
  source = new Source()
  sink = new Sink()
  source.out -> sink.in after 1 msec
}
