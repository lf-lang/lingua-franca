/**
 * Test lf_async_ext(), the version of lf_async() for externally defined reactions, which do not
 * have access to the lf_async() macro. Compare to ../AsyncManual.lf.
 *
 * Each Blocker reactor has an externally defined reaction that invokes slow(), which takes about
 * 500 ms, through lf_async_ext(), and then, at the logical time at which it is resumed, invokes it
 * again for about 200 ms. The reaction that resumes it, which calls lf_async_resume(), is also
 * externally defined. While these run, the timer reaction of the main reactor keeps firing every 20
 * ms, which is verified by checking that the physical time lag at each firing stays small.
 *
 * The two Blockers call lf_async_ext() concurrently, so two worker threads get added, but the
 * second call of each Blocker reuses them, so no further threads get added. The timeout leaves
 * enough margin for platforms where lf_sleep() overshoots significantly.
 */
target C {
  timeout: 2 sec,
  workers: 1,
  keepalive: true,
  cmake-include: ["../../../c/async_ext_manual.cmake"],
  files: ["../../../c"]
}

reactor Blocker(id: int = 0) {
  physical action awake
  state result: int = 0

  reaction resume(awake)  // Unblock the lf_async_ext() function.

  reaction block(startup) -> awake

  reaction check(shutdown)
}

main reactor {
  timer t(0, 20 ms)
  b = new[2] Blocker(id = {= bank_index =})
  state count: int = 0

  reaction(t) {=
    interval_t lag = lf_time_physical_elapsed() - lf_time_logical_elapsed();
    lf_print("Main at time " PRINTF_TIME " (lag " PRINTF_TIME ")", lf_time_logical_elapsed(), lag);
    self->count++;
    // If lf_async_ext() blocked the advancement of logical time, the timer events during the
    // 500 ms that slow() takes would all be processed late, with a lag of several hundred ms.
    if (lag > MSEC(250)) {
      lf_print_error_and_exit("Timer reaction is lagging physical time by " PRINTF_TIME " ns.", lag);
    }
  =}

  reaction(shutdown) {=
    if (self->count < 50) {
      lf_print_error_and_exit("Timer reaction fired %d times. Expected at least 50.", self->count);
    }
    if (lf_added_worker_thread_count() != 2) {
      lf_print_error_and_exit("Expected lf_async_ext() to add 2 worker threads. Got %d.",
                              lf_added_worker_thread_count());
    }
    lf_print("SUCCESS");
  =}
}
