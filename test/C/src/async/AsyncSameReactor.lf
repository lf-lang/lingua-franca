/**
 * Test that lf_async() queues downstream reactions instead of executing them in this thread.
 *
 * Source sets ping, and Relay copies it to pong, which triggers another reaction of
 * Source. With the usual inline optimization, that chain would execute the pong
 * reaction in this same thread: the relay is the only downstream reaction of startup,
 * and the pong reaction is the only downstream reaction of the relay. The pong
 * reaction also calls lf_async(). Executing it in place on the first call would
 * create Source's reactor mutex and leave the outer call unlocking a mutex it does
 * not hold. On the second call the outer reaction already holds that mutex, so
 * executing the pong reaction in place would deadlock trying to lock it.
 */
target C {
  timeout: 1 sec,
  workers: 1
}

reactor Relay {
  input in: int
  output out: int

  reaction(in) -> out {=
    lf_set(out, in->value);
  =}
}

reactor Source {
  preamble {=
    int pause(int milliseconds) {
      lf_sleep(MSEC(milliseconds));
      return milliseconds;
    }
  =}
  physical action awake
  output ping: int
  input pong: int
  state from_async: int = 0
  state from_pong: int = 0
  state saw: int = 0

  reaction(awake) {=
    lf_async_resume(awake);
  =}

  reaction(startup) -> ping {=
    // The relay runs in place and sets pong. The pong reaction of this reactor
    // must be queued, then run at this tag after this call releases the mutex.
    lf_set(ping, 1);
    self->from_async = lf_async(pause, 20);
    // This call holds the reactor mutex created by the first call.
    lf_set(ping, 2);
    self->from_async += lf_async(pause, 20);
  =}

  reaction(pong) {=
    self->saw += pong->value;
    self->from_pong += lf_async(pause, 1);
  =}

  reaction(shutdown) {=
    if (self->from_async != 40) {
      lf_print_error_and_exit("Expected lf_async() in startup to return 40. Got %d.", self->from_async);
    }
    if (self->saw != 3 || self->from_pong != 2) {
      lf_print_error_and_exit("Expected both pong reactions to run. saw=%d from_pong=%d.", self->saw, self->from_pong);
    }
  =}
}

main reactor {
  source = new Source()
  relay = new Relay()
  source.ping -> relay.in
  relay.out -> source.pong

  reaction(shutdown) {=
    lf_print("SUCCESS");
  =}
}
