/**
 * Test lf_async(), which invokes a function that may block for a long time without blocking the
 * advancement of logical time or the execution of other reactions.
 *
 * Each Blocker uses `lf_async` to invoke slow(), which takes about 500 ms, and then, at the logical
 * time at which it is resumed, invokes it again for another 500 ms. While these run, the timer
 * reaction of the main reactor fires at 250 ms and 750 ms. When slow() returns, lf_async()
 * schedules the physical action awake and resumes the calling reaction at the tag of that event, so
 * the results are reported at logical times at least 500 ms and 1 s after the start. The test
 * checks that the timer ticks occur during the slow() calls.
 *
 * The two Blockers call lf_async() concurrently, so two worker threads get added, but the second
 * call of each Blocker reuses them, so no further threads get added.
 */
target C {
  timeout: 2 s,
  workers: 1,
  keepalive: true
}

reactor Blocker(id: int = 0) {
  preamble {=
    int slow(int iterations) {
      int result = 0;
      for (int j = 0; j < iterations; j++) {
        result++;
        lf_sleep(MSEC(500));
      }
      return result;
    }
  =}
  physical action awake
  output blocker: int
  state result: int = 0

  reaction(awake) {=
    // Unblock the `lf_async` function.
    lf_async_resume(awake);
  =}

  reaction(startup) -> blocker, awake {=
    lf_print("Starting Blocker %d", self->id);
    // These outputs must be delivered at this tag, before lf_async() lets logical time advance.
    lf_set(blocker, 1);
    lf_print("Blocker blocking.");
    int result = lf_async(awake, slow, 1);
    lf_print("Blocker resuming %d: Result: %d at logical time " PRINTF_TIME, self->id, result, lf_time_logical_elapsed());
    if (lf_time_logical_elapsed() < MSEC(500)) {
      lf_print_error_and_exit("Expected lf_async() to return at a logical time of at least 500 ms.");
    }
    lf_set(blocker, 2);
    result += lf_async(awake, slow, 1);
    lf_print("Blocker %d: Result: %d at logical time " PRINTF_TIME, self->id, result, lf_time_logical_elapsed());
    if (lf_time_logical_elapsed() < SEC(1)) {
      lf_print_error_and_exit("Expected second lf_async() to return at a logical time of at least 1 s.");
    }
    lf_set(blocker, 3);
    self->result = result;
  =}

  reaction(shutdown) {=
    if (self->result != 2) {
      lf_print_error_and_exit("Expected result 2 from lf_async(). Got %d.", self->result);
    }
  =}
}

reactor Checker {
  input blocker: int
  input tick: int
  state saw_ticks: int = 0

  reaction(blocker, tick) {=
    tag_t now = lf_tag();
    interval_t elapsed = lf_time_logical_elapsed();
    if (blocker->is_present) {
      lf_print("Checker received blocker %d at logical time " PRINTF_TIME ".", blocker->value, elapsed);
      if (blocker->value == 2 && self->saw_ticks != 1) {
        lf_print_error_and_exit("Tick not received before second blocker output.");
      } else if (blocker->value == 3 && self->saw_ticks != 2) {
        lf_print_error_and_exit("Tick not received before third blocker output.");
      }
    }
    if (tick->is_present) {
      lf_print("Checker received tick %d at logical time " PRINTF_TIME ".", tick->value, elapsed);
      self->saw_ticks++;
    }
  =}
}

main reactor {
  timer t(250 ms, 500 ms)
  b = new[2] Blocker(id = {= bank_index =})
  c = new[2] Checker()
  b.blocker -> c.blocker
  state count: int = 0

  reaction(t) -> c.tick {=
    interval_t lag = lf_time_physical_elapsed() - lf_time_logical_elapsed();
    lf_print("Tick at time " PRINTF_TIME " (lag " PRINTF_TIME ")", lf_time_logical_elapsed(), lag);
    self->count++;
    lf_set(c[0].tick, self->count);
    lf_set(c[1].tick, self->count);
  =}

  reaction(shutdown) {=
    if (self->count < 3) {
      lf_print_error_and_exit("Timer reaction fired %d times. Expected at least 3.", self->count);
    }
    if (lf_added_worker_thread_count() != 2) {
      lf_print_error_and_exit("Expected lf_async() to add 2 worker threads. Got %d.", lf_added_worker_thread_count());
    }
    lf_print("SUCCESS");
  =}
}
