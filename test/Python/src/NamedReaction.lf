/** Check that named reactions compile and run without errors. */
target Python

reactor User {
  output out

  reaction(startup) -> out {=
    out.set("Hello, world!")
  =}
}

reactor UI extends User {
  input current_value

  reaction u3(current_value) {=
    print(f"UI: current_value = {current_value.value}")
  =}
}

main reactor {
  u = new UI()
  u.out -> u.current_value
}
