/**
 * Test lf_async(), which invokes a function that may block for a long time without blocking the
 * advancement of logical time or the execution of other reactions.
 *
 * Each Blocker uses `lf_async` to invoke slow(), which takes about 500 ms, and then, at the logical
 * time at which it is resumed, invokes it again for another 500 ms. While these run, the timer
 * reaction of the main reactor fires at 250 ms and 750 ms. When slow() returns, lf_async()
 * schedules the physical action awake and resumes the calling reaction at the tag of that event, so
 * the results are reported at logical times at least 500 ms and 1 s after the start. The test
 * checks that the timer ticks occur during the slow() calls.
 *
 * The two Blockers call lf_async() concurrently, so two worker threads get added, but the second
 * call of each Blocker reuses them, so no further threads get added.
 */
target Python {
  timeout: 2 sec,
  workers: 1,
  keepalive: true
}

preamble {=
  import time

  def fail(message):
      sys.stderr.write(str(message) + "\n")
      sys.exit(1)

  def slow(iterations):
      result = 0
      for _ in range(iterations):
          result += 1
          time.sleep(0.5)
      return result
=}

reactor Blocker(id=0) {
  physical action awake
  output blocker
  state result = 0

  reaction(awake) {=
    # Unblock the `lf_async` function.
    self.lf_async_resume(awake)
  =}

  reaction(startup) -> blocker, awake {=
    print(f"Starting Blocker {self.id}")
    # These outputs must be delivered at this tag, before lf_async() lets logical time advance.
    blocker.set(1)
    print("Blocker blocking.")
    result = self.lf_async(awake, slow, 1)
    print(f"Blocker resuming {self.id}: Result: {result} at logical time {lf.time.logical_elapsed()}")
    if lf.time.logical_elapsed() < MSEC(500):
        fail("Expected lf_async() to return at a logical time of at least 500 ms.")
    blocker.set(2)
    result += self.lf_async(awake, slow, 1)
    print(f"Blocker {self.id}: Result: {result} at logical time {lf.time.logical_elapsed()}")
    if lf.time.logical_elapsed() < SEC(1):
        fail("Expected second lf_async() to return at a logical time of at least 1 s.")
    blocker.set(3)
    self.result = result
  =}

  reaction(shutdown) {=
    if self.result != 2:
        fail(f"Expected result 2 from lf_async(). Got {self.result}.")
  =}
}

reactor Checker {
  input blocker
  input tick
  state saw_ticks = 0

  reaction(blocker, tick) {=
    elapsed = lf.time.logical_elapsed()
    if blocker.is_present:
        print(f"Checker received blocker {blocker.value} at logical time {elapsed}.")
        if blocker.value == 2 and self.saw_ticks != 1:
            fail("Tick not received before second blocker output.")
        elif blocker.value == 3 and self.saw_ticks != 2:
            fail("Tick not received before third blocker output.")
    if tick.is_present:
        print(f"Checker received tick {tick.value} at logical time {elapsed}.")
        self.saw_ticks += 1
  =}
}

main reactor {
  timer t(250 ms, 500 ms)
  b = new[2] Blocker(id = {= bank_index =})
  c = new[2] Checker()
  b.blocker -> c.blocker
  state count = 0

  reaction(t) -> c.tick {=
    lag = lf.time.physical_elapsed() - lf.time.logical_elapsed()
    print(f"Tick at time {lf.time.logical_elapsed()} (lag {lag})")
    self.count += 1
    c[0].tick.set(self.count)
    c[1].tick.set(self.count)
  =}

  reaction(shutdown) {=
    if self.count < 3:
        fail(f"Timer reaction fired {self.count} times. Expected at least 3.")
    added = self.lf_added_worker_thread_count()
    if added != 2:
        fail(f"Expected lf_async() to add 2 worker threads. Got {added}.")
    print("SUCCESS")
  =}
}
