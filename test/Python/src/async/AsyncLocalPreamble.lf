/** Test lf_async() with a function that takes no parameters. */
target Python {
  timeout: 1 sec,
  workers: 1
}

reactor Blocker {
  preamble {=
    import time

    def fail(message):
        sys.stderr.write(str(message) + "\n")
        sys.exit(1)

    def slow():
        time.sleep(0.05)
        return 50
  =}
  logical action done(200 ms)
  state early = 0

  reaction(done) {=
    self.lf_async_resume(done)
  =}

  reaction(startup) -> done {=
    start = lf.time.logical_elapsed()
    print(f"Calling lf_async() at {start} (physical {lf.time.physical_elapsed()})")
    self.early = self.lf_async(done, self.slow)
    first = lf.time.logical_elapsed()
    print(f"First resume at {first} (physical {lf.time.physical_elapsed()})")
    if first != MSEC(200):
        self.fail(f"Expected the first lf_async() to resume at logical time 200 ms. Got {first}.")
  =}

  reaction(shutdown) {=
    if self.early != 50:
        self.fail(f"Unexpected results {self.early}.")
  =}
}

main reactor {
  b = new Blocker()
}
