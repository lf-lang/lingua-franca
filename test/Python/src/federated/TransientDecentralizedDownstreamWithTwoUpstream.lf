/**
 * This LF program tests whether a transient federate corretly leaves then joins the federation. It
 * also tests whether the transient's downstream executes as expected, that is it received correct
 * TAGs, regardless of the transient being absent or present. In this test:
 * - the transient federate spontaneously leaves the federation after 2 reactions to input port inp,
 * - the downstream of the transient federate has one persistent and one transient upstreams.
 *
 * In addition, the program tests if authentication works in case of a federation with transients,
 * by adding `auth` target property.
 */
target Python {
  timeout: 5 s,
  auth: true,
  coordination: decentralized
}

import Up from "TransientDecentralizedDownstreamWithTimer.lf"
import Middle from "TransientDecentralizedDownstreamWithTimer.lf"
import TransientExec from "TransientDecentralizedDownstreamWithTimer.lf"

/**
 * Persistent federate, which is downstream of the transient. It has to keep reacting to its
 * internal timer and also to inputs from the tansient, if any.
 */
reactor Down {
  timer t(0, 500 ms)

  input in_mid
  input in_up
  input join

  state count_timer = 0
  state count_join = 0
  state count_in_mid_reactions = 0
  state count_in_up_reactions = 0

  reaction(t) {=
    self.count_timer += 1
  =}

  reaction(join) {=
    self.count_join += 1
  =} tardy {=
    sys.stderr.write("Fatal error: federate Down received a tardy join event.\n")
    sys.exit(1)
  =}

  reaction(in_mid) {=
    self.count_in_mid_reactions += 1
  =} tardy {=
    sys.stderr.write("Fatal error: federate Down received a tardy in_mid event.\n")
    sys.exit(1)
  =}

  reaction(in_up) {=
    self.count_in_up_reactions += 1
  =} tardy {=
    sys.stderr.write("Fatal error: federate Down received a tardy in_up event.\n")
    sys.exit(1)
  =}

  reaction(shutdown) {=
    # Check that the TAG have been successfully issued to Down
    if self.count_timer < 5:
      sys.stderr.write("Federate's timer reacted {} times, while it had to react more than {} times.\n".format(
          self.count_timer, 5))
      sys.exit(1)
    if self.count_in_up_reactions < 7:
      sys.stderr.write("Federate's timer reacted {} times, while it had to react more than {} times.\n".format(
          self.count_in_up_reactions, 7))
      sys.exit(1)

    # Check that Middle have joined 2 times
    if self.count_join != 2:
      sys.stderr.write("Transient federate did not join twice, but {} times!\n".format(self.count_join))
      sys.exit(1)

    # Check that Middle have reacted correctly
    if self.count_in_mid_reactions < 4:
      sys.stderr.write("Transient federate Mid did not execute and pass values from up corretly! Expected >= 4, but had: {}.\n".format(
          self.count_in_mid_reactions))
      sys.exit(1)
  =}
}

federated reactor {
  // Persistent federate that is responsible for lauching the transient once, after 1s
  midExec = new TransientExec(launch_time = 1 s, federation_name = "TransientDecentralizedDownstreamWithTwoUpstream", fed_instance_name="mid")

  // Persistent downstream and upstream federates of the transient
  up1 = new Up()
  up2 = new Up(period = 300 msec)
  @maxwait(200 ms)
  down = new Down()

  // Transient federate
  @transient
  @maxwait(100 ms)
  mid = new Middle()

  // Connections
  up1.out -> mid.inp
  mid.join -> down.join
  mid.out -> down.in_mid
  up2.out -> down.in_up
}
