/**
 * This LF program is a variant of DecentralizedTransientDownstreamWithTimer that tests the Hot Swap
 * mechanism. For this, it tests whether the transient's downstream executes as expected and if
 * `mid` is stopped and the second instance joins as expected. In this test:
 * - the transient federate DOES NOT spontaneously leave the federation.
 * - the downstream of the transient federate has only one transient as upstream.
 * - A persistent federate `TransientExec` launches `mid` after 1s to activate the hot mechanism
 * swap.
 */
target Python {
  timeout: 5 s,
  auth: true,
  coordination: decentralized
}

import Up from "DecentralizedTransientDownstreamWithTimer.lf"
import Down from "DecentralizedTransientDownstreamWithTimer.lf"

/** Persistent federate that is responsible for lauching the transient federate */
reactor TransientExec(launch_time = 0, fed_instance_name = "instance") {
  preamble {=
    import subprocess
  =}
  timer t(launch_time, 0)

  reaction(t) {=
    bin_dir = os.path.join(lf.package_directory(), "fed-gen",
        "DecentralizedTransientHotSwap", "bin")
    launch_cmd = [os.path.join(bin_dir, "federate__" + self.fed_instance_name), "-i", lf.get_federation_id()]

    print("Launching federate__{} at physical time {}.".format(self.fed_instance_name, lf.time.physical()))

    result = self.subprocess.run(launch_cmd)
    if result.returncode == 0:
      print("Successfully launched federate__{}.".format(self.fed_instance_name))
    else:
      sys.stderr.write("Unable to launch federate__{}. Abort!\n".format(self.fed_instance_name))
      sys.exit(1)
  =}
}

/**
 * Transient federate that forwards whatever it receives from `Up` to `Down`. It reacts twice to
 * input port `inp`, then stops. It will execute twice during the lifetime of the federation. The
 * second launch is done by `TransientExec` at logical time 1 s. Each time `Middle` joins, it
 * notifies `Down`.
 */
reactor Middle {
  input inp
  output out
  output join
  state count = 0

  // Middle notifies its downstream that he joined, but make sure first that the effective start
  // tag is correct
  reaction(startup) -> join {=
    t = lf.tag_start_effective()
    if t.time < lf.time.start():
      sys.stderr.write("Fatal error: the transient's effective start time is less than the federation start time.\n")
      sys.exit(1)

    join.set(0)
  =}

  // Pass the input value to the output port
  reaction(inp) -> out {=
    self.count += 1
    out.set(inp.value)
  =} tardy {=
    sys.stderr.write("Fatal error: federate Middle received a tardy inp event.\n")
    sys.exit(1)
  =}
}

federated reactor {
  // Persistent federate that is responsible for lauching the transient once, after 1s
  midExec = new TransientExec(launch_time = 1 s, fed_instance_name="mid")

  // Persistent downstream and upstream federates of the transient
  up = new Up()
  @maxwait(200 ms)
  down = new Down()

  // Transient federate
  @transient
  @maxwait(100 ms)
  mid = new Middle()

  // Connections
  up.out -> mid.inp
  mid.join -> down.join
  mid.out -> down.inp
}
