/**
 * This LF program tests if a transient federate correctly leaves then joins the federation. It also
 * tests whether the transient's downstream executes as expected, that is it receives correct TAGs,
 * regardless of the transient being absent or present. In this test:
 * - the transient federate spontaneously leaves the federation after 2 reactions to input port
 * `inp`,
 * - the downstream of the transient federate has only one transient as upstream.
 */
target Python {
  timeout: 3 s
}

/**
 * Persistent federate, upstream of the transient. It reacts to its timer by sending increments to
 * output port out.
 */
reactor Up(period = 500 ms) {
  output out
  timer t(0, period)
  state count = 0

  reaction(t) -> out {=
    out.set(self.count)
    self.count += 1
  =}
}

/** Persistent federate that is responsible for lauching the transient federate */
reactor TransientExec(
    launch_time=0,
    federation_name="TransientDecentralizedDownstreamWithTimer",
    fed_instance_name="instance") {
  preamble {=
    import subprocess
  =}
  timer t(launch_time, 0)

  reaction(t) {=
    bin_dir = os.path.join(lf.package_directory(), "fed-gen", self.federation_name, "bin")
    launch_cmd = [os.path.join(bin_dir, "federate__" + self.fed_instance_name), "-i", lf.get_federation_id()]

    result = self.subprocess.run(launch_cmd)
    if result.returncode == 0:
      print("Successfully launched {}.".format(self.fed_instance_name))
    else:
      sys.stderr.write("Unable to launch {}. Abort!\n".format(self.fed_instance_name))
      sys.exit(1)
  =}
}

/**
 * Transient federate that forwards whatever it receives from `Up` to `Down`. It reacts twice to
 * input port `inp`, then stops. It will execute twice during the lifetime of the federation. The
 * second launch is done by `TransientExec` at logical time 1 s. Each time `Middle` joins, it
 * notifies `Down`.
 */
reactor Middle {
  input inp
  output out
  output join
  state count = 0

  # Middle notifies its downstream that he joined, but make sure first that the effective start
  # tag is correct
  reaction(startup) -> join {=
    t = lf.tag_start_effective()
    if t.time < lf.time.start():
      sys.stderr.write("Fatal error: the transient's effective start time is less than the federation start time.\n")
      sys.exit(1)

    join.set(0)
  =}

  # Pass the input value to the output port and stop spontaneously after two reactions to inp
  reaction(inp) -> out {=
    self.count += 1
    out.set(inp.value)

    if self.count == 2:
      lf.stop()
  =}
}

/**
 * Persistent federate, which is downstream of the transient. It has to keep reacting to its
 * internal timer and also to inputs from the tansient, if any.
 */
reactor Down(period = 500 ms) {
  timer t(0, period)

  input inp
  input join

  state count_timer = 0
  state count_join = 0
  state count_in_mid_reactions = 0

  reaction(t) {=
    self.count_timer += 1
  =}

  reaction(join) {=
    self.count_join += 1
  =}

  reaction(inp) {=
    self.count_in_mid_reactions += 1
  =}

  reaction(shutdown) {=
    # Check that the TAG has been successfully issued to Down
    if self.count_timer < 5:
      sys.stderr.write("Down federate's timer reacted {} times, while it had to react more than {} times.\n".format(
          self.count_timer, 5))
      sys.exit(1)

    # Check that `Middle` have joined 2 times
    if self.count_join != 2:
      sys.stderr.write("Transient federate did not join twice, but {} times!\n".format(self.count_join))
      sys.exit(1)

    # Check that `Middle` have reacted correctly
    if self.count_in_mid_reactions < 4:
      sys.stderr.write("Transient federate Mid did not execute and pass values from up correctly! Expected >= 4, but had: {}.\n".format(
          self.count_in_mid_reactions))
      sys.exit(1)
  =}
}

federated reactor {
  # Persistent federate that is responsible for lauching the transient once, after 1s
  midExec = new TransientExec(
      launch_time = 1 s,
      federation_name="TransientDownstreamWithTimer",
      fed_instance_name="mid")

  up = new Up()  # Persistent downstream and upstream federates of the transient
  down = new Down()

  # Transient federate
  @transient
  mid = new Middle()

  up.out -> mid.inp  # Connections
  mid.join -> down.join
  mid.out -> down.inp
}
