/**
 * This LF program tests if a transient federate correctly leaves then joins the federation. It also
 * tests whether the transient's downstream executes as expected, that is it receives correct TAGs,
 * regardless of the transient being absent or present. In this test:
 * - the transient federate spontaneously leaves the federation after 2 reactions to input port
 * `inp_val`,
 * - the downstream of the transient federate has only one transient as upstream.
 */
target Python {
  timeout: 6 s,
  coordination: decentralized
}

import Up from "TransientDownstreamWithTimer.lf"
import TransientExec from "TransientDownstreamWithTimer.lf"
import Down from "TransientDownstreamWithTimer.lf"

/**
 * Transient federate that forwards whatever it receives from `Up` to `Down`. It reacts twice to
 * input port `inp_val`, then stops. It will execute twice during the lifetime of the federation.
 * The second launch is done by `TransientExec` at logical time 1 s. Each time `Middle` joins, it
 * notifies `Down`.
 */
reactor Middle {
  input inp_val
  input inp
  output out
  output join
  state count = 0

  # Middle notifies its downstream that he joined, but make sure first that the effective start
  # tag is correct
  reaction(startup) -> join {=
    t = lf.tag_start_effective()
    if t.time < lf.time.start():
      sys.stderr.write("Fatal error: the transient's effective start time is less than the federation start time.\n")
      sys.exit(1)

    join.set(0)
  =}

  # Pass the input value to the output port and stop spontaneously after two reactions to inp_val
  reaction(inp_val) -> out {=
    self.count += 1
    out.set(inp_val.value)

    if self.count == 2:
      lf.stop()
  =} tardy {=
    sys.stderr.write("Fatal error: federate Middle received a tardy inp_val event.\n")
    sys.exit(1)
  =}

  reaction(inp) {=
    print("Transient federate received value {} on port inp at logical tag ({}, {}).".format(
        inp.value, lf.tag().time, lf.tag().microstep))
  =}
}

federated reactor {
  # Persistent federate that is responsible for lauching the transient once, after 1s
  midExec = new TransientExec(
      launch_time = 1 s,
      federation_name="TransientDecentralizedWithPhysicalConnection",
      fed_instance_name="mid")

  up = new Up()  # Persistent downstream and upstream federates of the transient
  @maxwait(0)
  down = new Down()

  # Transient federate
  @transient
  @maxwait(250 ms)
  mid = new Middle()

  up.out -> mid.inp_val  # Connections
  @absent_after(300 ms)
  mid.join -> down.join
  @absent_after(350 ms)
  mid.out -> down.inp
  up.out ~> mid.inp
}
