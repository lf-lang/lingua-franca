target Python {
  timeout: 1 ms
}

reactor UI {
  input current_value
  output out

  reaction(startup) -> out {=
    out.set(42)
  =}

  reaction(current_value) {=
    print(f"UI: current_value = {current_value.value}")
    if current_value.value != 42:
      print("Expected 42.")
      self.sys.exit(1)
  =}
}

federated reactor {
  u = new UI()
  u.out -> u.current_value
}
