// This tests the ability to depend on crates with cargo if this compiles it's fine
// We have to use "" to allow for antlr to accept the crate name
target Rust {
  cargo-dependencies: {
    "reactor-rs": {
      features: ["parallel-runtime"]
    }
  }
}

main reactor {
  reaction(startup) {=
    println!("success")
  =}
}
